# Copy to .env for local Docker Compose. Never commit real secrets.

POSTGRES_USER=familyos
POSTGRES_PASSWORD=familyos_dev_only
POSTGRES_DB=familyos
DATABASE_URL=postgresql+psycopg://familyos:familyos_dev_only@postgres:5432/familyos
# Host-side Postgres is published on 5433 if you run Alembic outside Compose.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-long-random-string
SESSION_COOKIE_NAME=ffos_session
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
CORS_ORIGINS=http://localhost:3000
# Production HTTPS: COOKIE_SECURE=true. SameSite=lax is suitable for the same-origin Cloudflare frontend/API proxy.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional. Empty disables POST /api/v1/billing/webhook (returns 503).
BILLING_WEBHOOK_SECRET=

# Optional privacy-safe error reporting. Empty disables external reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

NEXT_PUBLIC_API_URL=http://localhost:8000

# Inbound bank-alert forwarding (configure a provider such as Postmark inbound parse).
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_WEBHOOK_SECRET=
MAX_IMPORT_UPLOAD_BYTES=10485760

# Runtime application role (least privilege; DML only). Use Neon pooled URL if pooling is enabled.
DATABASE_URL=
# Optional owner/migration connection used only by Alembic during container startup.
# Keep this secret separate from the runtime role and never expose it to the frontend.
DATABASE_MIGRATION_URL=
