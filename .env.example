# Copy to .env for local Docker Compose. Never commit real secrets.

POSTGRES_USER=familyos
POSTGRES_PASSWORD=familyos_dev_only
POSTGRES_DB=familyos
DATABASE_URL=postgresql+psycopg://familyos:familyos_dev_only@postgres:5432/familyos
# Host-side Postgres is published on 5433 if you run Alembic outside Compose.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-long-random-string
SESSION_COOKIE_NAME=ffos_session
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
CORS_ORIGINS=http://localhost:3000
# Cross-origin (Vercel + separate API): COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional. Empty disables POST /api/v1/billing/webhook (returns 503).
BILLING_WEBHOOK_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:8000
